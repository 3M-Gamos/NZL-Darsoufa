---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props { place: CollectionEntry<'places'>; lang: Lang; compact?: boolean }
const { place, lang, compact = false } = Astro.props;
const t = useTranslations(lang);
const d = place.data;
const tip = d.tip?.[lang];
---
<article class:list={['card flex flex-col p-6', compact && 'p-5']}>
  <div class="flex items-start justify-between gap-3">
    <h3 class:list={[compact ? 'text-xl' : 'text-2xl', 'leading-tight']}>{d.name[lang]}</h3>
    <span class="shrink-0 rounded-full bg-sand px-2.5 py-1 text-[0.7rem] font-medium uppercase tracking-wider text-ink-soft">{t(`rabat.${d.category}`)}</span>
  </div>
  <p class="mt-1 inline-flex items-center gap-1.5 text-xs text-ink-muted"><Icon name="map" size={14} /> {d.distance[lang]}</p>
  <p class="mt-3 text-sm leading-relaxed text-ink-soft">{d.description[lang]}</p>
  {tip && (
    <p class="mt-3 rounded-xl bg-zellige-light/70 px-3 py-2 text-xs leading-relaxed text-zellige-dark">
      <strong class="font-medium">{t('rabat.tip')} :</strong> {tip}
    </p>
  )}
  <div class="mt-auto pt-5">
    <a href={d.mapsUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-medium text-terracotta hover:text-terracotta-dark">
      <Icon name="external" size={16} /> {t('rabat.maps')}
    </a>
  </div>
</article>
