---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
}
const { eyebrow, title, text, align = 'left', as: Tag = 'h2' } = Astro.props;
---
<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class:list={['eyebrow mb-4', align === 'center' && 'justify-center']}>{eyebrow}</p>}
  <Tag class:list={[Tag === 'h1' ? 'text-4xl sm:text-5xl lg:text-6xl' : 'text-3xl sm:text-4xl lg:text-[2.75rem]', 'leading-[1.05]']}>{title}</Tag>
  {text && <p class="mt-5 text-base leading-relaxed text-ink-soft sm:text-lg">{text}</p>}
</div>
