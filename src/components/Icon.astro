  breakfast: '<path d="M4 9h11a3 3 0 0 1 0 6H4z"/><path d="M15 10h2a2 2 0 0 1 0 4h-2"/><path d="M4 15v2a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2v-2"/><path d="M7 5c0-1 1-1 1-2M10 5c0-1 1-1 1-2"/>',
  plane: '<path d="M2 16l20-6-8-2-4-6h-2l2 7-7 2-2-2H0l2 4-2 4h1l2-2 7 2-2 7h2l4-6 8-2z"/>',
  train: '<rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 10h14"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/><path d="M8 21l2-4M16 21l-2-4"/>',
  car: '<path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5v5h-2v-2H5v2H3z"/><circle cx="7.5" cy="15.5" r="1"/><circle cx="16.5" cy="15.5" r="1"/>',
  spa: '<path d="M12 21c-4-2-7-5-7-9a7 7 0 0 1 7-7 7 7 0 0 1 7 7c0 4-3 7-7 9z"/><path d="M12 5v16"/><path d="M12 12c-2-1-4-1-6 0M12 12c2-1 4-1 6 0"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-4 2 2-6z"/>',
  star: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
  wifi: '<path d="M2 9a15 15 0 0 1 20 0"/><path d="M5.5 12.5a10 10 0 0 1 13 0"/><path d="M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="0.8" fill="currentColor"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  map: '<path d="M12 21s-6-5.3-6-11a6 6 0 0 1 12 0c0 5.7-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/>',
  parking: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 17V7h3.5a3 3 0 0 1 0 6H9"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  whatsapp: '<path d="M4 20l1.3-3.8A8.5 8.5 0 1 1 8.2 19z"/><path d="M9.5 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2z"/>',
  arrow: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
