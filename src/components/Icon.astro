---
/**
 * Icônes SVG inline (traits fins) — aucune dépendance externe.
 */
export type IconName =
  | 'dinner' | 'breakfast' | 'plane' | 'train' | 'car' | 'spa' | 'compass' | 'star'
  | 'wifi' | 'clock' | 'map' | 'parking' | 'phone' | 'mail' | 'whatsapp' | 'arrow'
  | 'external' | 'copy' | 'check' | 'menu' | 'close' | 'users' | 'ruler' | 'bed'
  | 'home' | 'info' | 'alert' | 'instagram' | 'facebook' | 'qr';

type Props = { name: IconName; class?: string; size?: number } & Record<`data-${string}`, string>;
const { name, class: className = '', size = 20, ...rest } = Astro.props;

const paths: Record<IconName, string> = {
