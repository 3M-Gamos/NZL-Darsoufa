---
import type { Lang, RouteKey } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import Icon from './Icon.astro';

interface Props { lang: Lang; page: RouteKey; bookingUrl: string; siteName: string }
const { lang, page, bookingUrl, siteName } = Astro.props;
const t = useTranslations(lang);

const items: { key: RouteKey; label: string }[] = [
  { key: 'rooms', label: t('nav.rooms') },
  { key: 'services', label: t('nav.services') },
  { key: 'rabat', label: t('nav.rabat') },
  { key: 'contact', label: t('nav.contact') },
  { key: 'guide', label: t('nav.guide') },
];
---
<header class="sticky top-0 z-40 border-b border-sand-dark/60 bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/80">
  <div class="container-x flex h-16 items-center justify-between gap-4 sm:h-20">
    <a href={localePath(lang, 'home')} class="flex items-baseline gap-2" aria-label={siteName}>
      <span class="font-display text-2xl font-semibold tracking-tight sm:text-[1.7rem]">{siteName}</span>
      <span class="hidden text-[0.65rem] uppercase tracking-[0.25em] text-ink-muted sm:inline">Rabat</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navigation">
      {items.map((item) => (
        <a
          href={localePath(lang, item.key)}
          aria-current={item.key === page ? 'page' : undefined}
          class:list={[
            'text-sm tracking-wide transition-colors hover:text-terracotta',
            item.key === page ? 'text-terracotta' : 'text-ink-soft',
          ]}
        >{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <LangSwitch lang={lang} page={page} compact class="hidden sm:inline-flex" />
      <a href={bookingUrl} target="_blank" rel="noopener" class="btn-primary hidden !py-2.5 sm:inline-flex">{t('nav.book')}</a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-ink/20 lg:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" class="block" data-icon="open" />
        <Icon name="close" class="hidden" data-icon="close" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-sand-dark/60 bg-paper lg:hidden" data-menu>
    <nav class="container-x flex flex-col py-4" aria-label="Navigation mobile">
      {items.map((item) => (
        <a
          href={localePath(lang, item.key)}
          aria-current={item.key === page ? 'page' : undefined}
          class:list={[
            'border-b border-sand-dark/50 py-3.5 font-display text-2xl',
            item.key === page ? 'text-terracotta' : 'text-ink',
          ]}
        >{item.label}</a>
      ))}
      <div class="flex items-center justify-between gap-3 pt-5">
        <LangSwitch lang={lang} page={page} />
        <a href={bookingUrl} target="_blank" rel="noopener" class="btn-primary">{t('nav.book')}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const open = toggle.querySelector<SVGElement>('[data-icon="open"]');
    const close = toggle.querySelector<SVGElement>('[data-icon="close"]');
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden', expanded);
      open?.classList.toggle('hidden', !expanded);
      close?.classList.toggle('hidden', expanded);
    });
  }
</script>
